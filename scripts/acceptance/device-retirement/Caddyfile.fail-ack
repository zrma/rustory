{
	admin off
	auto_https disable_redirects
}

https://{$RUSTORY_ACCEPTANCE_TLS_NAME}:9443 {
	bind 192.168.64.1
	tls {$RUSTORY_ACCEPTANCE_CERT_FILE} {$RUSTORY_ACCEPTANCE_KEY_FILE}

	@retirementAck path /api/v1/devices/retirement/ack
	respond @retirementAck "acceptance fault: retirement ack unavailable" 503

	reverse_proxy 127.0.0.1:8860
}
